<% if (bundler === 'rsbuild') { -%>
{
  "scripts": {
    "start": "rsbuild preview",
    "deploy": "<%= packageManager %> run build && wrangler deploy --config .output/server/wrangler.json"
  },
  "dependencies": {
    "nitro": "3.0.261103-rc"
  },
  "devDependencies": {
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ]
  }
}
<% } else { -%>
{
  "scripts": {
    "deploy": "<%= packageManager %> run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "workerd"]
  }
}
<% } -%>
