import { createRouter as createTanStackRouter } from '@tanstack/react-router'
import { routeTree } from './routeTree.gen'
<% if (addOnEnabled['tanstack-query']) { %><% if (addOnEnabled.tRPC || routerOnly) { %>
import type { ReactNode } from 'react'<% } %>
<% if (routerOnly) { %>
import { QueryClientProvider } from '@tanstack/react-query'
<% } else { %>
import { setupRouterSsrQueryIntegration } from "@tanstack/react-router-ssr-query";
<% } %>
import <% if (addOnEnabled.tRPC) { %>TanstackQueryProvider, <% } %>{ getContext } from './integrations/tanstack-query/root-provider'
<% } %>

export function getRouter() {
  <% if (addOnEnabled['tanstack-query']) { %>
  const context = getContext();
  <% } %>
  
  const router = createTanStackRouter({
    routeTree,<% if (addOnEnabled['tanstack-query']) { %>
    context,<% } else if (addOnEnabled['apollo-client']) { %>
    context: {} as any,
<% } %>
    scrollRestoration: true,
    defaultPreload: 'intent',
    defaultPreloadStaleTime: 0,
    <% if (addOnEnabled['tanstack-query'] && (addOnEnabled.tRPC || routerOnly)) { %>
    Wrap: (props: { children: ReactNode }) => {
      return (
        <% if (routerOnly) { %><QueryClientProvider client={context.queryClient}><% } %>
        <% if (addOnEnabled.tRPC) { %><TanstackQueryProvider context={context}><% } %>
            {props.children}
        <% if (addOnEnabled.tRPC) { %></TanstackQueryProvider><% } %>
        <% if (routerOnly) { %></QueryClientProvider><% } %>
        );
      },
    <% } %>
  })

<% if (addOnEnabled['tanstack-query'] && !routerOnly) { %>
  setupRouterSsrQueryIntegration({ router, queryClient: context.queryClient })
<% } %>

  return router
}

declare module '@tanstack/react-router' {
  interface Register {
    router: ReturnType<typeof getRouter>
  }
}
