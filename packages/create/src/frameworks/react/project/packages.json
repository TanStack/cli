{
  "typescript": {
    "devDependencies": {
      "@types/react": "^19.2.0",
      "@types/node": "^22.10.2",
      "@types/react-dom": "^19.2.0",
      "typescript": "^6.0.2"
    }
  },
  "tailwindcss": {
    "dependencies": {
      "tailwindcss": "^4.1.18"
    }
  },
  "devtools": {
