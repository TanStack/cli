<% const worker = addOnEnabled.cloudflare; const nodePreload = !worker && !addOnEnabled.vercel; -%>
{
  "scripts": {
    "build": <%- JSON.stringify(nodePreload ? 'vite build && cp instrument.server.mjs .output/server' : 'vite build') %>,
    "dev": <%- JSON.stringify(nodePreload ? 'dotenv -e .env.local -- sh -c \"NODE_OPTIONS=\'--import ./instrument.server.mjs\' vite dev --port 3000\"' : 'dotenv -e .env.local -- vite dev --port 3000') %>,
    "start": "<%= worker ? 'vite preview' : nodePreload ? 'node --import ./.output/server/instrument.server.mjs .output/server/index.mjs' : 'node .output/server/index.mjs' %>"
  },
  "dependencies": {
    "@sentry/tanstackstart-react": "^10.67.0",
    <% if (worker) { %>"@sentry/cloudflare": "^10.67.0",
    <% } %>"dotenv-cli": "^11.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ]
  }
}
