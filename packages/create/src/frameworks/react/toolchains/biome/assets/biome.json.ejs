{
	"$schema": "https://biomejs.dev/schemas/<%= addOnOption?.biome?.preset === 'ultracite' ? '2.6.7' : '2.4.5' %>/schema.json",
	<% if (addOnOption?.biome?.preset === 'ultracite') { %>"extends": ["ultracite/biome/core", "ultracite/biome/react"],
	"overrides": [{
		"includes": ["**/src/components/**"],
		"linter": { "rules": { "style": { "useFilenamingConvention": {
			"level": "error", "options": { "filenameCases": ["PascalCase", "kebab-case"] }
		} } } }
	}],<% } %>
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			<% if (bundler === 'vite') { %>"**/index.html",
			<% } %>"**/<%= bundler %>.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
<% if (bundler) { %><% } %>
